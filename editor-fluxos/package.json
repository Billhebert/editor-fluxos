{
  "name": "editor-fluxos",
  "version": "1.0.3",
  "description": "FLUXO - Editor de fluxos para automacao",
  "main": "dist/main.js",
  "scripts": {
    "start": "tsc && electron .",
    "build": "tsc && electron-builder --win",
    "publish": "tsc && electron-builder --win --publish always",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bump-major": "npm version major",
    "bump-minor": "npm version minor",
    "bump-patch": "npm version patch"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.editorfluxos.app",
    "productName": "FLUXO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/**/*",
      "index.html",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Billhebert",
      "repo": "editor-fluxos",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "electron-updater": "^6.6.2"
  }
}
